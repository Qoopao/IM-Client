  <property name="styleSheet">
   <string>QWidget#mainIM { background: #f2f4f7; }
QWidget { font-family: &quot;Microsoft YaHei&quot;; font-size: 13px; color: #333333; }
QWidget#headerWidget { background: #f2f4f7; }
QWidget#navigationWidget { background: #e9edf2; border-radius: 10px; }
QWidget#conversationPanel, QWidget#chatWidget, QWidget#contactsPanel, QWidget#contactInfoWidget, QWidget#friendRequestsPage { background: #ffffff; border-radius: 10px; }
QLabel { background: transparent; }
QLabel#brandLabel { font-size: 16px; font-weight: bold; }
QLabel#statusLabel { color: #808080; font-size: 12px; }
QLabel#conversationTitle, QLabel#contactsTitle, QLabel#friendRequestsTitle, QLabel#titleLabel { font-size: 16px; font-weight: bold; }
QLabel#contactsPlaceholder { color: #808080; font-size: 16px; }
QPushButton { border: none; border-radius: 7px; padding: 7px 12px; background: transparent; }
QPushButton:hover { background: #e5eaf0; }
QPushButton#conversationButton, QPushButton#contactsButton { color: #808080; padding: 12px 4px; }
QPushButton#conversationButton:checked, QPushButton#contactsButton:checked { color: #0099FF; background: #ffffff; font-weight: bold; }
QPushButton#openChatButton, QPushButton#sendButton { background: #0099FF; color: #FCFCFC; }
QPushButton#openChatButton:hover, QPushButton#sendButton:hover { background: #008DE8; }
QPushButton#openChatButton:pressed, QPushButton#sendButton:pressed { background: #007bc9; }
QPushButton#sendButton:disabled { background: #d9e7f1; color: #ffffff; }
QPushButton#minimizeButton, QPushButton#maximizeButton, QPushButton#shutdownButton { padding: 0; font-size: 18px; border-radius: 5px; }
QPushButton#shutdownButton:hover { background: #ff4444; color: white; }
QLineEdit#peerEdit, QLineEdit#contactsSearchEdit { background: #f2f4f7; border: 1px solid transparent; border-radius: 8px; padding: 8px; selection-background-color: #0099FF; }
QLineEdit#peerEdit:focus, QLineEdit#contactsSearchEdit:focus { border: 1px solid #0099FF; }
QListWidget#conversationList { background: #ffffff; border: none; outline: none; }
QListWidget#conversationList::item { padding: 12px 8px; margin: 3px 0; border-radius: 7px; }
QListWidget#conversationList::item:hover { background: #f2f6fa; }
QListWidget#conversationList::item:selected { background: #e6f4ff; color: #008DE8; }
QTextBrowser#historyBrowser { background: #ffffff; border: none; padding: 8px; selection-background-color: #0099FF; }
QTextEdit#messageEdit { background: #f7f9fb; border: 1px solid #e5eaf0; border-radius: 10px; padding: 10px; selection-background-color: #0099FF; }
QTextEdit#messageEdit:focus { border: 1px solid #0099FF; }
QSplitter::handle { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #d2dae3; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QTreeWidget#contactsTree { background: #ffffff; border: none; outline: none; }
QTreeWidget#contactsTree::item { padding: 12px 6px; border-radius: 7px; }
QTreeWidget#contactsTree::item:hover { background: #f2f6fa; }
QTreeWidget#contactsTree::branch,
QTreeWidget#contactsTree::branch:hover { background: #ffffff; border: none; border-image: none; }
QTreeWidget#contactsTree::branch:has-children:closed,
QTreeWidget#contactsTree::branch:has-children:closed:hover { image: url(:/icons/collapse); }
QTreeWidget#contactsTree::branch:has-children:open,
QTreeWidget#contactsTree::branch:has-children:open:hover { image: url(:/icons/expand); }
QTreeWidget#contactsTree::item:selected { background: #e6f4ff; color: #008DE8; }
QTreeWidget#contactsTree::item:disabled { color: #a0a8b2; }
QPushButton#friendRequestsButton { text-align: left; background: #f2f6fa; }
QPushButton#friendRequestsButton:checked { background: #e6f4ff; color: #008DE8; }
QLabel#friendRequestsEmptyLabel { color: #808080; }
QListWidget#friendRequestsList { background: white; border: none; }
</string>
