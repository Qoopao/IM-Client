<RCC>
    <qresource prefix="/gif">
        <file alias="firework">media/image/fireworkbg.gif</file>
    </qresource>
    <qresource prefix="/jpg">
        <file alias="ape">media/image/ape.jpg</file>
        <file alias="elep">media/image/elep.jpg</file>
    </qresource>
    <qresource prefix="/cert">
        <file>ca.crt</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="expand">media/icons/expand.svg</file>
        <file alias="collapse">media/icons/collapse.svg</file>
        <file alias="chat">media/icons/chat.svg</file>
        <file alias="chat-selected">media/icons/chat-selected.svg</file>
        <file alias="people">media/icons/people.svg</file>
        <file alias="people-selected">media/icons/people-selected.svg</file>
    </qresource>
</RCC>
